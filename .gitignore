# ----- Ignore node_modules inside all subfolders -----
**/node_modules/

# ----- Ignore build/dist from any project (React or Node) -----
**/build/
**/dist/

# ----- Environment files (don’t upload secrets) -----
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.test

# ----- Logs -----
**/*.log
logs/
**/logs/

# ----- OS/system files -----
.DS_Store
Thumbs.db

# ----- IDE/editor settings -----
.vscode/
.idea/

# ----- Temp/cache files -----
**/.cache/
**/.temp/

# ----- Optional: uploads (if your backend stores images locally) -----
backend/uploads/
